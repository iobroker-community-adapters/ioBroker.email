{
  "name": "iobroker.email",
  "description": "Send e-mails from ioBroker",
  "version": "3.0.0",
  "author": "bluefox <dogafox@gmail.com>",
  "contributors": [
    "bluefox <dogafox@gmail.com>",
    "Sneak-L8",
    "iobroker-community-adapters <iobroker-community-adapters@gmx.de>"
  ],
  "homepage": "https://github.com/iobroker-community-adapters/ioBroker.email",
  "repository": {
    "type": "git",
    "url": "https://github.com/iobroker-community-adapters/ioBroker.email"
  },
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "email",
    "home automation",
    "IoT"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "axios": "^1.19.0",
    "googleapis": "^178.0.0",
    "nodemailer": "^9.0.5"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/build-tools": "^3.0.1",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.1.2",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^8.0.1",
    "blockly": "^13.2.1",
    "esbuild": "^0.28.2",
    "typescript": "~6.0.3"
  },
  "bugs": {
    "url": "https://github.com/iobroker-community-adapters/ioBroker.email/issues"
  },
  "main": "build/main.js",
  "files": [
    "admin/",
    "build/",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "test:js": "mocha --config test/mocharc.custom.json \"{!(node_modules|test)/**/*.test.js,*.test.js,test/**/test!(PackageFiles|Startup).js}\"",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:js && npm run test:package",
    "tsc": "tsc -p tsconfig.build.json",
    "build:blockly": "tsc -p src-blockly/tsconfig.json && node src-blockly/build.mjs",
    "build": "tsc -p tsconfig.build.json && node tasks.mts && npm run build:blockly",
    "build:admin": "node tasks.mts --admin-build",
    "build:rules": "node tasks.mts --rules-build",
    "lint": "eslint -c eslint.config.mjs",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tasks.json && tsc --noEmit -p src-blockly/tsconfig.json",
    "translate": "translate-adapter -b admin/i18n/en.json -b src-blockly/i18n/en.json",
    "update-packages": "npx -y npm-check-updates --upgrade && cd src-admin && npx -y npm-check-updates --upgrade && cd ../src-rules && npx -y npm-check-updates --upgrade",
    "npm": "npm i && cd src-admin && npm i && cd ../src-rules && npm i",
    "release": "release-script",
    "release-patch": "release-script patch --yes",
    "release-minor": "release-script minor --yes",
    "release-major": "release-script major --yes"
  }
}
